# For deploy-act.sh, copy .act.secrets.example to .act.secrets instead.
SERVER_HOST=
SERVER_PORT=
SITE_NAME=
SITE_DESCRIPTION=
SITE_KEYWORDS=
SITE_DOMAIN=
API_BASEURL=
OSS_BASEURL=
